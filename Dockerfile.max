# =====================================================================
# graft-Max MCP server — Docker 镜像（自研专用，与上游 GitHub App 的
# Dockerfile 完全独立：那个是 HTTP webhook 服务，这个是 MCP stdio +
# 可选 Dashboard）。
#
#   docker build -f Dockerfile.max -t graft-max .
#   docker run -i --rm -v "D:\repo:/workspace" graft-max mcp          # MCP stdio
#   docker compose -f docker-compose.max.yml up -d                    # 常驻面板
#
# 为什么不用 python3/make/g++（关键）：
#   所有原生 tree-sitter 语法包都在 devDependencies，**运行时走 WASM**
#   （tree-sitter-wasm + web-tree-sitter）。所以 `npm ci --ignore-scripts`
#   跳过原生编译即可，构建从 10+ 分钟降到 ~20 秒，也彻底摆脱 apt 大包下载
#   （gcc-12/g++-12 约 40MB，国内网络极易卡死）。
#
# 网络：默认国内镜像源（apt → mirrors.aliyun.com，npm → registry.npmmirror.com），
# 容器内实测直连可达，无需代理。海外用 --build-arg 切回官方源：
#   --build-arg APT_MIRROR=deb.debian.org --build-arg NPM_REGISTRY=https://registry.npmjs.org
#
# 联邦后端按仓库可选；未装时 probe 门控自动隐藏对应工具（零 schema 占用），
# graft_*/max_* 六件套始终可用。运行身份 node（非 root）。
# =====================================================================

# ---- 构建阶段 ----
FROM node:22-bookworm-slim AS build
ARG APT_MIRROR=mirrors.aliyun.com
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}
WORKDIR /app
COPY package.json package-lock.json ./
# 掉我们自己的 prepare（需要源码），并跳过原生编译（运行时用 WASM 语法）
RUN npm pkg delete scripts.prepare scripts.postinstall \
    && npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN node scripts/postinstall.mjs && npm run build \
    && node dist/cli.js --version

# ---- 运行阶段 ----
FROM node:22-bookworm-slim
ARG APT_MIRROR=mirrors.aliyun.com
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}
# git 是运行时依赖（分支/基线探测），curl 供 healthcheck；都是小包
RUN sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# 只留运行时依赖；--ignore-scripts 防止 prepare 无 tsc 时重建
RUN npm prune --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force

# ---- 联邦后端（可选）----
ARG INSTALL_QMD=1
ARG INSTALL_CCC=0
ARG INSTALL_GITNEXUS=0
RUN if [ "$INSTALL_QMD" = "1" ]; then \
      npm install -g @tobilu/qmd --no-audit --no-fund \
      && mkdir -p /home/node/.cache/qmd && chown -R node:node /home/node/.cache ; \
    fi
RUN if [ "$INSTALL_CCC" = "1" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
      && apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
      && pip3 install --break-system-packages --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple cocoindex-code \
      && rm -rf /var/lib/apt/lists/* ; \
    fi
RUN if [ "$INSTALL_GITNEXUS" = "1" ]; then npm install -g gitnexus --no-audit --no-fund; fi

EXPOSE 24688
ENV GRAFT_MAX_UI=24688
ENV GRAFT_MAX_LOG=1
# stdio 交互式会话保留 leash（宿主崩溃自愈）；常驻容器由 compose 设 GRAFT_MAX_LEASH=0
ENV GRAFT_MAX_LEASH=1
# 容器内必须绑 0.0.0.0，否则 -p 端口映射到不了（docker DNAT 打容器 eth0）
ENV GRAFT_MAX_UI_HOST=0.0.0.0

# 运行时要写的两个目录必须在镜像里就存在且属于 node：
# Docker 用命名卷覆盖一个**不存在**的路径时会建成 root:root，以 node 运行就写不进去
# ——实测踩到：max-home 卷 root 属主 → 日志/会话文件全写不进，面板所有数据"未创建"。
RUN mkdir -p /home/node/.graft-max /home/node/.trail /home/node/.cache/qmd     && chown -R node:node /home/node/.graft-max /home/node/.trail /home/node/.cache

USER node
WORKDIR /workspace
VOLUME ["/workspace"]

ENTRYPOINT ["node", "/app/dist/cli.js"]
CMD ["mcp", "/workspace"]
