{
  "name": "graft-max",
  "version": "0.28.0-max.12",
  "description": "[graft-Max] Self-developed fork of graft (nanonets/graft v0.28.0) - repo context graph + planned unified MCP aggregation for our toolchain.",
  "keywords": [
    "ai",
    "agents",
    "knowledge-graph",
    "context",
    "codebase",
    "llm",
    "graft"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lza6/graft-Max.git"
  },
  "homepage": "https://github.com/lza6/graft-Max#readme",
  "bugs": {
    "url": "https://github.com/lza6/graft-Max/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "graft": "dist/bin/graft.js",
    "graft-max": "dist/bin/graft.js",
    "trail": "dist/bin/trail.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p viewer/tsconfig.json && tsc -p panel/tsconfig.json && node scripts/build-viewer.mjs && node scripts/build-panel.mjs && node scripts/vendor-grammars.mjs",
    "build:panel": "tsc -p panel/tsconfig.json && node scripts/build-panel.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "cli": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "npm run build && node scripts/stamp-telemetry-key.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "gray-matter": "^4.0.3",
    "openai": "^7.8.0",
    "tree-sitter-wasm": "^2.0.4",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "web-tree-sitter": "^0.27.1",
    "web-tree-sitter-depth": "npm:web-tree-sitter@0.22.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.1",
    "node-gyp": "^12.4.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.23.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-r": "npm:@davisvaughan/tree-sitter-r@^1.3.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-go@0.23.4": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-java@0.23.5": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "tree-sitter-kotlin@0.3.8": true,
    "tree-sitter-php@0.23.12": true,
    "@davisvaughan/tree-sitter-r@1.3.0": true,
    "tree-sitter-swift@0.7.1": true
  },
  "overrides": {
    "tree-sitter-swift": {
      "tree-sitter": "$tree-sitter"
    },
    "js-yaml": {
      "argparse": "^2.0.1"
    }
  }
}
